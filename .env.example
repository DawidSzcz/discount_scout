# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true

POSTGRES_DB=discount_scout
POSTGRES_USER=discount_scout
POSTGRES_PASSWORD=discount_scout

# Gmail SMTP with an app password. Leave EMAIL_BACKEND unset to print emails to the console instead.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Recipient of alerts and summaries (can also be set per user in Settings).
SCOUT_NOTIFY_EMAIL=

GEMINI_API_KEY=
